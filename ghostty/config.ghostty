background = 080808
foreground = D8DEE9
background-opacity = 1
background-image = /home/gustavo/.config/ghostty/background.jpg
background-image-opacity = 0.005
background-image-fit = contain

# Mesma paleta normal e clara do Alacritty.
palette = 0=#222833
palette = 1=#BF616A
palette = 2=#A3BE8C
palette = 3=#EBCB8B
palette = 4=#81A1C1
palette = 5=#B48EAD
palette = 6=#88C0D0
palette = 7=#E5E9F0
palette = 8=#384252
palette = 9=#BF616A
palette = 10=#A3BE8C
palette = 11=#EBCB8B
palette = 12=#81A1C1
palette = 13=#B48EAD
palette = 14=#8FBCBB
palette = 15=#ECEFF4
bold-color = bright

cursor-text = cell-background
cursor-style = underline
cursor-style-blink = false
window-decoration = none

font-family = "Cascadia Code"
font-family-bold = "Cascadia Code"
font-family-italic = "Cascadia Code"
font-family-bold-italic = "Cascadia Code"
font-style = Light
font-style-bold = Bold
font-style-italic = Light Italic
font-style-bold-italic = Bold Italic
font-size = 13
font-feature = -calt, -liga, -dlig
alpha-blending = native

keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+d=new_split:right
# Deixa o Neovim receber a seleção por palavra e a troca de buffers.
keybind = ctrl+shift+left=unbind
keybind = ctrl+shift+right=unbind
keybind = ctrl+tab=unbind
keybind = ctrl+shift+tab=unbind
