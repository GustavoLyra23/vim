{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Pastel Branco",
  "author": "Gustavo Lyra",
  "themes": [
    {
      "name": "Pastel Branco",
      "appearance": "light",
      "style": {
        "background.appearance": "opaque",
        "background": "#fdfcf9",
        "surface.background": "#f5f3ee",
        "elevated_surface.background": "#f5f3ee",
        "panel.background": "#fdfcf9",
        "editor.background": "#fdfcf9",
        "editor.foreground": "#292d32",
        "editor.gutter.background": "#fdfcf9",
        "editor.active_line.background": "#fdfcf9",
        "editor.highlighted_line.background": "#f1eee7",
        "editor.line_number": "#999990",
        "editor.active_line_number": "#72736c",
        "editor.indent_guide": "#e7e4dd",
        "editor.indent_guide_active": "#d6d2c9",
        "editor.wrap_guide": "#e7e4dd",
        "editor.document_highlight.read_background": "#e9e5f1",
        "editor.document_highlight.write_background": "#e9e5f1",
        "border": "#e7e4dd",
        "border.variant": "#efede7",
        "border.focused": "#b8adc8",
        "element.background": "#f5f3ee",
        "element.hover": "#f1eee7",
        "element.selected": "#e9e5f1",
        "ghost_element.hover": "#f1eee7",
        "ghost_element.selected": "#e9e5f1",
        "text": "#292d32",
        "text.muted": "#72736c",
        "text.placeholder": "#999990",
        "text.accent": "#a34f9e",
        "icon": "#72736c",
        "icon.accent": "#a34f9e",
        "title_bar.background": "#f5f3ee",
        "title_bar.inactive_background": "#f5f3ee",
        "tab_bar.background": "#f5f3ee",
        "tab.active_background": "#fdfcf9",
        "tab.inactive_background": "#f5f3ee",
        "toolbar.background": "#fdfcf9",
        "status_bar.background": "#f5f3ee",
        "scrollbar.track.background": "#fdfcf9",
        "scrollbar.thumb.background": "#d6d2c980",
        "search.match_background": "#efe3bd",
        "players": [{ "cursor": "#6651ae", "background": "#6651ae", "selection": "#e9e5f1" }],
        "error": "#a45a64",
        "error.background": "#f8e9eb",
        "warning": "#8b6747",
        "warning.background": "#f6eddf",
        "success": "#57783b",
        "success.background": "#edf3e7",
        "info": "#417c84",
        "info.background": "#e7f1f2",
        "hint": "#72736c",
        "created": "#57783b",
        "modified": "#8b6747",
        "deleted": "#a45a64",
        "terminal.background": "#fdfcf9",
        "terminal.foreground": "#292d32",
        "terminal.ansi.black": "#292d32",
        "terminal.ansi.red": "#a45a64",
        "terminal.ansi.green": "#57783b",
        "terminal.ansi.yellow": "#8b6747",
        "terminal.ansi.blue": "#6651ae",
        "terminal.ansi.magenta": "#a34f9e",
        "terminal.ansi.cyan": "#417c84",
        "terminal.ansi.white": "#e7e4dd",
        "syntax": {
          "comment": { "color": "#4b7d4b", "font_style": "normal" },
          "comment.doc": { "color": "#4b7d4b", "font_style": "normal" },
          "keyword": { "color": "#a34f9e" },
          "keyword.directive": { "color": "#8b6747" },
          "preproc": { "color": "#8b6747" },
          "type": { "color": "#a34f9e" },
          "type.builtin": { "color": "#a34f9e" },
          "constant": { "color": "#a34f9e" },
          "constant.builtin": { "color": "#a34f9e" },
          "boolean": { "color": "#a34f9e" },
          "number": { "color": "#6651ae" },
          "string": { "color": "#57783b" },
          "string.escape": { "color": "#417c84" },
          "function": { "color": "#292d32" },
          "function.macro": { "color": "#8b6747" },
          "method": { "color": "#292d32" },
          "variable": { "color": "#292d32" },
          "property": { "color": "#292d32" },
          "operator": { "color": "#292d32" },
          "punctuation": { "color": "#292d32" },
          "punctuation.bracket": { "color": "#292d32" },
          "punctuation.delimiter": { "color": "#292d32" },
          "tag": { "color": "#8b6747" }
        }
      }
    }
  ]
}
